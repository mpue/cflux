# Database
DATABASE_URL="postgresql://user:password@localhost:5432/timetracking?schema=public"

# JWT
JWT_SECRET="your-secret-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Gotenberg (Document to PDF conversion)
GOTENBERG_URL="http://localhost:3000"

# Frontend URL (for password reset links - use port 3002 for Docker, 3000 for local dev)
FRONTEND_URL="http://localhost:3002"
